# ==============================================================================
# AI CHAT APPLICATION - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and populate your API keys.
# DO NOT COMMIT YOUR REAL '.env' FILE TO GITHUB!
# ==============================================================================

# Primary LLM API Keys (Provide at least one, or use simulation mode)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Default Model Selection: gpt-4o-mini | gpt-4o | gemini-1.5-flash | claude-3-5-sonnet | mock-llm
DEFAULT_MODEL=gpt-4o-mini

# Model Hyperparameters
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=1024
DEFAULT_TOP_P=0.95

# Cost & Token Management
MAX_CONTEXT_TOKENS=4096
SESSION_BUDGET_USD=0.50
ENABLE_COST_ALERTS=true

# Application Settings
DEBUG_MODE=false
PORT=8000
